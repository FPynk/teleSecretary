# Copy this file to .env and fill in local values.
TELEGRAM_BOT_TOKEN=
# Comma-separated independent Telegram owners. Leave empty to disable commands.
TELEGRAM_ALLOWED_USER_IDS=

SECRETARY_DATA_DIR=./data
SECRETARY_LOG_DIR=./logs
SECRETARY_DB_PATH=./data/secretary.sqlite3
# Default timezone for a Telegram user created for the first time.
SECRETARY_USER_TIMEZONE=America/Chicago
SECRETARY_LOG_LEVEL=INFO

# OpenAI Responses API model for the future validated LLM configuration.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.6-luna
